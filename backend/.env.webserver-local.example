# ============================================================================
# PUG corporate website — backend/.env for the SHARED LOCAL WEBSERVER deploy
# ============================================================================
# Copy to backend/.env on the host, then fill in the real values:
#     copy backend\.env.webserver-local.example backend\.env   (PowerShell)
#
# Only the values that MUST be set for a clean production boot are listed.
# docker-compose.webserver-local.yml injects the infra coordinates
# (POSTGRES_HOST=postgres, POSTGRES_PORT=5432, REDIS_URL=redis://redis:6379/0,
# APP_ENV=production, UPLOAD_DIR=/app/uploads) so you do NOT set those here.
# See backend/.env.example for the full catalogue of optional settings
# (R2, AI providers, SMTP, IMAP, Sentry, etc.).
# ============================================================================

# --- REQUIRED: security -----------------------------------------------------
# The API REFUSES to start in production without a strong, unique SECRET_KEY
# (>= 32 chars, not the placeholder). Generate one (PowerShell):
#     python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-64-char-random-secret

# --- REQUIRED: database creds (read by postgres initdb AND the backend) -----
POSTGRES_USER=pug_user
POSTGRES_PASSWORD=replace-with-a-strong-db-password
POSTGRES_DB=pug_holding

# --- REQUIRED: public origin + CORS allowlist -------------------------------
# CORS_ORIGINS must be explicit in production (no "*"). Match your domain.
PUBLIC_SITE_URL=https://parisunitedgroup.com
CORS_ORIGINS=https://parisunitedgroup.com,https://www.parisunitedgroup.com

# --- OPTIONAL: object storage (recommended for media in production) ---------
# When all four are set, uploads go to Cloudflare R2 instead of local disk.
# R2_ENDPOINT_URL=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=pug-holding-media
# R2_PUBLIC_BASE_URL=

# --- OPTIONAL: AI assistant + semantic search -------------------------------
# AI_ENABLED=true
# AI_PROVIDER=azure            # azure | openai_compatible | ollama
# AI_BASE_URL=
# AI_API_KEY=
# AI_MODEL=
# AI_EMBEDDING_PROVIDER=azure
# AI_EMBEDDING_BASE_URL=
# AI_EMBEDDING_API_KEY=
# AI_EMBEDDING_MODEL=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=

# --- OPTIONAL: outbound email + error tracking ------------------------------
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
# SENTRY_DSN=
